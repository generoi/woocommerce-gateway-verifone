#. translators: 1: a href link 2: closing href
#: includes/class-wc-gateway-verifone.php:38
#, php-format
msgid ""
"Verifone payment. For more information please see %1$sVerifone page%2$s."
msgstr ""
"Verifone verkkomaksut. Lisää tietoa saat Verifonen %1$sverkkosivuilta%2$s."

#: includes/class-wc-gateway-verifone.php:125
msgid "Select payment method"
msgstr "Valitse maksutapa"

#: includes/class-wc-gateway-verifone.php:126
msgid "Remember payment method."
msgstr "Tallenna maksutapa"

#: includes/class-wc-gateway-verifone.php:128
msgid ""
"You will be redirected to Verifone Payment service to complete your order."
msgstr "Sinut ohjataan Verifonen maksuportaaliin viimeistelemään ostos."

#: includes/class-wc-gateway-verifone.php:147
msgid ""
"You will be redirect to Verifone Payment Service to process adding payment "
"card."
msgstr "Sinut ohjataa Verifonen portaaliin lisäämään maksukortti."

#: includes/class-wc-gateway-verifone.php:274
msgid ""
"Attempted refund, but rejected by Verifone.Possible reasons: payment not "
"committed, payment has already been refunded or similar.Please try again "
"later, or check status from Verifones TCS portal."
msgstr ""
"Yritettiin palautusta, mutta pyyntö hylättiin Verifonelta. Mahdollisia syitä:"
" maksuvaraus on epäonnistunut, maksu on jo palautettu tai vastaavaa. Ole "
"hyvä ja yritä uudelleen tai tarkista tilanne Verifonen TCS portaalista."

#: includes/class-wc-gateway-verifone.php:285
#, php-format
msgid "Refunded %1$s - Refund ID: %2$s - Reason: %3$s"
msgstr "Hyvitetty %1$s - Hyvityksen ID: %2$s - Syy: %3$s"

