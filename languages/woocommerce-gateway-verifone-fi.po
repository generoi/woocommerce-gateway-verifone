msgid ""
"Order status is now [pending] because payment for this order was NOT found."
msgstr "Tilauksen tila on nyt [pending] koska maksusuoritusta ei löytynyt."

#: includes/helpers/wc-verifone-observer.php:124
msgid ""
"Order status is now [cancel] because payment for this order was cancelled"
msgstr "Tilauksen tila on nyt [cancel] koska maksusuoritusta oli peruttu."

