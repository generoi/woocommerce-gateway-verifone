msgid "Your card has been rejected."
msgstr "Kortti hylättiin."

#: includes/helpers/core/wc-verifone-savedPaymentMethods.php:106
msgid "Your card has been successfully added."
msgstr "Kortti tallennettu onnistuneesti."

